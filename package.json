{
  "name": "incremental-game",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:mutation": "mutator"
  },
  "devDependencies": {
    "@mizchi/mutator": "0.5.0",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "fast-check": "4.10.3",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
