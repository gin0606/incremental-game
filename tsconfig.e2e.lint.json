{
  "$schema": "https://www.schemastore.org/tsconfig",
  // oxlint の型情報を使うルールに、e2e/ と playwright.config.ts を tsconfig.e2e.json と同じ compiler options で
  // 検査させるための設定。理由は tsconfig.json の references のコメントにある。
  "extends": "./tsconfig.e2e.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    // 検査（`pnpm run typecheck` を含む）やビルドで書き出す tsbuildinfo と .d.ts を、Git と型検査の対象の外に置く。
    "outDir": "node_modules/.cache/tsconfig-lint/e2e"
  }
}
